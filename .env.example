# PayPal app credentials — https://developer.paypal.com/dashboard/applications
# Client ID is public (used by the browser SDK).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Client secret is SERVER-ONLY. Never commit it or prefix it with NEXT_PUBLIC_.
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) for testing, "live" for real payments. Must match the credentials above.
PAYPAL_ENV=sandbox

# Secret used to sign download links (32+ random chars), e.g. `openssl rand -hex 32`
DOWNLOAD_TOKEN_SECRET=

# --- Optional: order receipts by email (https://resend.com) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend. Without it, Resend's test sender
# only delivers to your own Resend account email.
# EMAIL_FROM="Luma Store <orders@yourdomain.com>"
EMAIL_REPLY_TO=
# Public site URL used for links in emails (defaults to the request origin)
# SITE_URL=https://yourdomain.com

# --- Optional: save orders to Postgres (Neon / Vercel Postgres) ---
# The "orders" table is created automatically on the first order.
DATABASE_URL=
